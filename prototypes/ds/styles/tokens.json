  "type": {
    "$note": "family At Hauss Std, letterSpacing 0, weight numeric. Verified 1:1 against the Figma text-style export (Tokens Studio). 'figmaStyle' = source style name; 'inLeanRoles': false = exists in Figma but not in the dev's lean 10-role ladder (candidate to adopt).",
    "display": {
      "size": 36,
      "lineHeight": 50,
      "weight": 600,
      "figmaStyle": "36SB",
      "inLeanRoles": false,
      "note": "hero greeting (Home AI chat)"
    },
    "pageTitle": {
      "size": 24,
      "lineHeight": 30,
      "weight": 600,
      "figmaStyle": "24SB"
    },
    "sectionTitle": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "figmaStyle": "20SB",
      "note": "section headers (e.g. Performance)"
    },
    "kpiValue": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "figmaStyle": "20SB",
      "note": "same spec as sectionTitle"
    },
    "subheading": {
      "size": 18,
      "lineHeight": 26,
      "weight": 600,
      "figmaStyle": "18SB",
      "note": "card titles (e.g. Good morning)"
    },
    "bodyStrong": {
      "size": 16,
      "lineHeight": 24,
      "weight": 500,
      "figmaStyle": "16M"
    },
    "bodyEmphasis": {
      "size": 16,
      "lineHeight": 24,
      "weight": 600,
      "figmaStyle": "16SB"
