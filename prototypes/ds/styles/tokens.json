{
  "$meta": {
    "description": "Njorda design tokens in four layers. 'palette' = primitives (raw colours, theme-independent, no meaning). 'brand' = the only layer a brand / organization overrides (primary, onPrimary, bg — light + dark). 'color.core' = semantic tokens (surface / fg / border / accent), each resolving to a palette or brand token — 'ref' names it where it is the brand. 'color.extension' = component tokens that map onto core via 'mapsTo'. Entries with 'inLeanTokensTs': false exist in Figma but aren't in the app's tokens.ts yet. Every colour has a light and a dark value.",
    "source": "Figma — Njorda app with AI assistant (Dev Mode)",
    "themes": [
      "light",
      "dark"
    ],
    "layers": [
      "palette",
      "brand",
      "color.core",
      "color.extension"
    ],
    "naming": {
      "palette": "--palette-{hue}-{step}",
      "brand": "--brand-{role}",
      "core": "--color-{group}-{role}[-{state}]",
      "component": "--{component}-{part}[-{state}]"
    },
    "whiteLabel": "A brand / organization overrides brand.primary and brand.bg (light + dark). primaryPressed, tint and onPrimary are derived; nothing else changes."
  },
  "palette": {
    "neutral": {
      "0": "#ffffff",
      "25": "#f9f9f9",
      "50": "#f5f5f5",
      "100": "#eaeaea",
      "300": "#dbdbdb",
      "400": "#b7b7b7",
      "450": "#8b8b8b",
      "500": "#7f7f7f",
      "600": "#707070"
    },
    "ink": {
      "600": "#535654",
      "700": "#2e322f",
      "800": "#252926",
      "850": "#1d211e",
      "900": "#191d1a"
    },
    "green": {
      "25": "#f8fffa",
      "50": "#e2ffea",
      "400": "#6fff95",
      "500": "#4cff7b",
      "600": "#43d46a",
      "700": "#3aae57",
      "800": "#2b8040",
      "900": "#21412a",
      "920": "#1e3122",
      "950": "#1b261e"
    },
    "red": {
      "50": "#ffedeb",
      "200": "#fbc7c1",
      "300": "#ff8989",
      "350": "#ff4d4d",
      "400": "#ff4747",
      "500": "#ff3131",
      "600": "#de0000",
      "800": "#711f1f",
      "950": "#3e1f1f"
    },
    "amber": {
      "50": "#fff3dd",
      "300": "#feb741",
      "400": "#f5a623",
      "500": "#ff9500",
      "600": "#c57e09",
      "700": "#a35f00",
      "950": "#332d1b"
    },
    "cyan": {
      "50": "#e6fcfd",
      "400": "#00ebf3",
      "500": "#01e1e9",
      "600": "#00bada",
      "700": "#007b91",
      "950": "#17302e"
    }
  },
  "brand": {
    "primary": {
      "light": "#4cff7b",
      "dark": "#4cff7b",
      "ref": "palette.green.500",
      "source": "brand.json theme.brandLight / brandDark",
      "use": "primary actions, selection, highlights (fills only)"
    },
    "primaryPressed": {
      "light": "#43d46a",
      "dark": "#6fff95",
      "ref": "derived from brand.primary",
      "use": "pressed primary action",
      "derived": "light: mix(primary 80%, ink #191d1a 20%) · dark: mix(primary 80%, white 20%)"
    },
    "accent": {
      "light": "#01e1e9",
      "dark": "#01e1e9",
      "ref": "palette.cyan.500",
      "use": "second brand colour — gradient end, chart accent"
    },
    "tint": {
      "light": "#e2ffea",
      "dark": "#21412a",
      "ref": "derived from brand.primary",
      "use": "light brand tint — AI highlight surface",
      "derived": "light: mix(primary 16%, white) · dark: mix(primary 15%, ink #191d1a)"
    },
    "onPrimary": {
      "light": "#191d1a",
      "dark": "#191d1a",
      "ref": "palette.ink.900",
      "use": "text and icons on the brand colour",
      "derived": "ink #191d1a or white #ffffff — whichever has the higher contrast with brand.primary (≥ 4.5:1)"
    },
    "bg": {
      "light": "#f5f5f5",
      "dark": "#252926",
      "ref": "palette.neutral.50 / palette.ink.800",
      "source": "brand.json theme.bgLight / bgDark",
      "use": "page background"
    },
    "onDark": {
      "light": "#4cff7b",
      "dark": "#4cff7b",
      "derived": "brand.primary mixed with white until contrast ≥ 4.5:1 on static-dark #191d1a",
      "use": "active tab-bar item on the dark bar"
    }
  },
  "color": {
    "core": {
      "surface-primary": {
        "light": "#f5f5f5",
        "dark": "#252926",
        "ref": "brand.bg"
      },
      "surface-secondary": {
        "light": "#ffffff",
        "dark": "#191d1a"
      },
      "surface-tertiary": {
        "light": "#eaeaea",
        "dark": "#1d211e"
      },
      "surface-success": {
        "light": "#f8fffa",
        "dark": "#1e3122"
      },
      "surface-warning": {
        "light": "#fff3dd",
        "dark": "#332d1b"
      },
      "surface-negative": {
        "light": "#ffedeb",
        "dark": "#3e1f1f"
      },
      "surface-info": {
        "light": "#e6fcfd",
        "dark": "#17302e",
        "inLeanTokensTs": false
      },
      "surface-ai-highlight": {
        "light": "#e2ffea",
        "dark": "#21412a",
        "inLeanTokensTs": false,
        "ref": "brand.tint"
      },
      "fg-primary": {
        "light": "#191d1a",
        "dark": "#f5f5f5"
      },
      "fg-secondary": {
        "light": "#707070",
        "dark": "#b7b7b7",
        "figma": "#7f7f7f",
        "note": "darkened for WCAG AA"
      },
      "fg-tertiary": {
        "light": "#8b8b8b",
        "dark": "#7f7f7f",
        "figma": "#b7b7b7",
        "note": "icons only (3:1) · darkened for WCAG AA"
      },
      "fg-positive": {
        "light": "#2b8040",
        "dark": "#4cff7b",
        "figma": "#3aae57",
        "note": "darkened for WCAG AA"
      },
      "fg-negative": {
        "light": "#de0000",
        "dark": "#ff4d4d",
        "figma": "#ff3131 / dark #ff4747",
        "note": "darkened for WCAG AA"
      },
      "fg-warning": {
        "light": "#a35f00",
        "dark": "#f5a623",
        "figma": "#ff9500",
        "note": "darkened for WCAG AA"
      },
      "fg-static-black": {
        "light": "#191d1a",
        "dark": "#191d1a"
      },
      "fg-info": {
        "light": "#007b91",
        "dark": "#01e1e9",
        "inLeanTokensTs": false,
        "figma": "#00bada",
        "note": "darkened for WCAG AA"
      },
      "icon-info": {
        "light": "#01e1e9",
        "dark": "#00ebf3",
        "inLeanTokensTs": false,
        "note": "info icon — differs from fg-info (text)"
      },
      "icon-warning": {
        "light": "#c57e09",
        "dark": "#feb741",
        "inLeanTokensTs": false,
        "note": "warning icon — differs from fg-warning (text) · darkened for WCAG AA",
        "figma": "#f5a623"
      },
      "border-primary": {
        "light": "#eaeaea",
        "dark": "#2e322f"
      },
      "border-primary-hover": {
        "light": "#dbdbdb",
        "dark": "#7f7f7f"
      },
      "border-secondary": {
        "light": "#b7b7b7",
        "dark": "#535654",
        "inLeanTokensTs": false
      },
      "border-green": {
        "light": "#4cff7b",
        "dark": "#4cff7b",
        "ref": "brand.primary",
        "note": "action colour — Figma name border/green"
      },
      "border-green-hover": {
        "light": "#43d46a",
        "dark": "#6fff95",
        "ref": "brand.primaryPressed"
      },
      "border-error": {
        "light": "#ff8989",
        "dark": "#ff4747",
        "inLeanTokensTs": false
      },
      "accent": {
        "light": "#01e1e9",
        "dark": "#01e1e9",
        "ref": "brand.accent"
      }
    },
    "extension": {
      "neutral-disabled": {
        "light": "#dbdbdb",
        "dark": "#7f7f7f",
        "inLeanTokensTs": false,
        "mapsTo": "Figma neutral/300 — toggle-off, chart area, disabled fills"
      },
      "static-dark": {
        "light": "#191d1a",
        "dark": "#191d1a",
        "mapsTo": "theme-independent (dark tab bar / toast)"
      },
      "on-static": {
        "light": "#f5f5f5",
        "dark": "#f5f5f5",
        "mapsTo": "theme-independent (text on static-dark)"
      },
      "btn-primary-bg": {
        "mapsTo": "border-green"
      },
      "btn-primary-fg": {
        "mapsTo": "brand.onPrimary"
      },
      "btn-primary-bg-pressed": {
        "mapsTo": "border-green-hover"
      },
      "btn-primary-bg-disabled": {
